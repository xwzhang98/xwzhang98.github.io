@article{zhang2024sr3,
    abbr = {MNRAS},
    author = {Zhang, Xiaowen and Lachance, Patrick and Ni, Yueying and Li, Yin and Croft, Rupert A C and Di Matteo, Tiziana and Bird, Simeon and Feng, Yu},
    title = {AI-assisted super-resolution cosmological simulations III: time evolution},
    journal = {Monthly Notices of the Royal Astronomical Society},
    volume = {528},
    number = {1},
    pages = {281--293},
    year = {2024},
    month = {2},
    doi = {10.1093/mnras/stad3940},
    url = {https://doi.org/10.1093/mnras/stad3940},
    html = {https://doi.org/10.1093/mnras/stad3940},
    arxiv = {2312.05295},
    code = {https://github.com/xwzhang98/map2map/tree/stylegan2},
    abstract = {We extend our super-resolution (SR) model for cosmological simulations to produce fully time-consistent evolving representations of the particle phase-space distribution. We employ a style-based constrained generative adversarial network, where cosmic time is an input style parameter to the network. The matter power spectrum and halo mass function agree well with high-resolution N-body results over the full trained redshift range (10 >= z >= 0), and halo merger trees confirm the temporal consistency of the generated simulations.},
    selected = {true},
}

@article{zhang2025sr4,
    abbr = {OJA},
    author = {Zhang, Xiaowen and Lachance, Patrick and Dasgupta, Ankita and Croft, Rupert A. C. and Di Matteo, Tiziana and Ni, Yueying and Bird, Simeon and Li, Yin},
    title = {AI-assisted super-resolution cosmological simulations IV: An emulator for deterministic realizations},
    journal = {The Open Journal of Astrophysics},
    volume = {8},
    pages = {E13},
    year = {2025},
    month = {2},
    doi = {10.33232/001c.129471},
    url = {https://doi.org/10.33232/001c.129471},
    html = {https://astro.theoj.org/article/129471-ai-assisted-super-resolution-cosmological-simulations-iv-an-emulator-for-deterministic-realizations},
    arxiv = {2408.09051},
    code = {https://github.com/xwzhang98/SREmulator},
    abstract = {Super-resolution is an inverse problem: one low-resolution field maps to many plausible high-resolution realizations. We introduce a deterministic emulator that conditions on high-resolution initial conditions to recover the specific target realization, improving dark matter halo accuracy, merger trees, and Fourier-space cross-correlation against full N-body references.},
    selected = {true},
}

@inproceedings{zhang2025simagents,
    abbr = {IJCNLP},
    author = {Zhang, Xiaowen and Bi, Zhenyu and LaChance, Patrick and Wang, Xuan and Di Matteo, Tiziana and Croft, Rupert},
    title = {SimAgents: Bridging Literature and the Universe Via A Multi-Agent Large Language Model System},
    booktitle = {Proceedings of the 14th International Joint Conference on Natural Language Processing and the 4th Conference of the Asia-Pacific Chapter of the Association for Computational Linguistics: System Demonstrations},
    pages = {55--66},
    publisher = {Association for Computational Linguistics},
    year = {2025},
    month = {12},
    doi = {10.18653/v1/2025.ijcnlp-demo.7},
    url = {https://aclanthology.org/2025.ijcnlp-demo.7/},
    html = {https://aclanthology.org/2025.ijcnlp-demo.7/},
    arxiv = {2507.08958},
    abstract = {SimAgents shortens the loop from reading a paper to running a cosmological simulation: two task-specialized agents (a Physics Agent reading the literature, a Software Agent reading the software manual) refine parameters over multi-round structured discussion, auto-generate MP-GADGET configurations, and produce first-look analyses. 98.7 Micro-F1 on parameter extraction, an 80 percent error-rate reduction over a single-agent chain-of-thought baseline, and an 83x setup speedup for first-time users.},
    selected = {true},
}

@article{hafezianzadeh2025lya,
    abbr = {arXiv},
    author = {Hafezianzadeh, Fatemeh and Zhang, Xiaowen and Ni, Yueying and Croft, Rupert A. C. and Di Matteo, Tiziana and Qezlou, Mahdi and Bird, Simeon},
    title = {An AI super-resolution field emulator for cosmological hydrodynamics: the Lyman-alpha forest},
    journal = {arXiv e-prints},
    year = {2025},
    month = {7},
    doi = {10.48550/arXiv.2507.16189},
    url = {https://arxiv.org/abs/2507.16189},
    html = {https://arxiv.org/abs/2507.16189},
    arxiv = {2507.16189},
    note = {Led by a graduate student I mentor},
    abstract = {A two-stage model emulating high-resolution hydrodynamic fields (gas and stars) from low-resolution runs at z=3, achieving sub-percent errors on overdensity, temperature, velocity, and optical-depth fields at roughly 450x the speed of SPH at matched resolution, enabling high-fidelity Lyman-alpha sightline prediction.},
}

