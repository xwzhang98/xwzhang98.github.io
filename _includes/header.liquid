{% assign about_page = site.pages | where: 'permalink', '/' | first %}
<header class="masthead">
  <div class="container">
    <div class="masthead__bar">
      <!-- Letterhead -->
      <div class="masthead__plate">
        <a class="masthead__name" href="{{ '/' | relative_url }}">
          {%- if site.title == 'blank' -%}
            {{ site.first_name -}}
            {%- if site.middle_name %} {{ site.middle_name }}{% endif %}
            {{ site.last_name }}
          {%- else -%}
            {{ site.title }}
          {%- endif -%}
        </a>
        {% if about_page.subtitle %}
          <p class="masthead__tag">{{ about_page.subtitle }}</p>
        {% endif %}
      </div>

      <button
        class="navbar-toggler collapsed"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
      >
        Menu
      </button>

      <!-- Nav Bar -->
      <nav id="navbar" class="navbar navbar-expand-md masthead__nav" aria-label="Main">
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <!-- About -->
            <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
              <a
                class="nav-link"
                href="{{ '/' | relative_url }}"
                {% if page.permalink == '/' %}
                  aria-current="page"
                {% endif %}
              >
                {{- about_page.title -}}
              </a>
            </li>

            <!-- Other pages -->
            {% assign sorted_pages = site.pages | sort: 'nav_order' %}
            {% for p in sorted_pages %}
              {% if p.nav and p.autogen == null %}
                {% if p.dropdown %}
                  {% assign has_active_child = false %}
                  {% for child in p.children %}
                    {% if page.title == child.title %}
                      {% assign has_active_child = true %}
                    {% endif %}
                  {% endfor %}
                  <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                    <a
                      class="nav-link dropdown-toggle"
                      href="#"
                      id="navbarDropdown"
                      role="button"
                      data-toggle="dropdown"
                      aria-haspopup="true"
                      aria-expanded="false"
                    >
                      {{- p.title -}}
                    </a>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                      {% for child in p.children %}
                        {% if child.title == 'divider' %}
                          <div class="dropdown-divider"></div>
                        {% else %}
                          <a
                            class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                            href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                          >
                            {{- child.title -}}
                          </a>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </li>
                {% else %}
                  {% assign parent_link = p.permalink | remove: 'index.html' %}
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                    <a
                      class="nav-link"
                      href="{{ url | relative_url }}"
                      {% if page.url contains p.url %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- p.title -}}
                    </a>
                  </li>
                {% endif %}
              {% endif %}
            {% endfor %}

            {% if site.data.socials.email %}
              <!-- Contact -->
              <li class="nav-item">
                <a class="nav-link" href="mailto:{{ site.data.socials.email | encode_email }}">Email</a>
              </li>
            {% endif %}
          </ul>

          <ul class="masthead__tools">
            {% if site.search_enabled %}
              <!-- Search -->
              <li>
                <button id="search-toggle" type="button" title="Search" aria-label="Search" onclick="openSearchModal()">
                  <span class="nav-link">ctrl k <i class="ti ti-search" aria-hidden="true"></i></span>
                </button>
              </li>
            {% endif %}
            {% if site.enable_darkmode %}
              <!-- Toggle theme mode -->
              <li class="toggle-container">
                <button id="light-toggle" type="button" title="Change theme" aria-label="Change theme">
                  <i class="ti ti-sun-moon" id="light-toggle-system" aria-hidden="true"></i>
                  <i class="ti ti-moon-filled" id="light-toggle-dark" aria-hidden="true"></i>
                  <i class="ti ti-sun-filled" id="light-toggle-light" aria-hidden="true"></i>
                </button>
              </li>
            {% endif %}
          </ul>
        </div>
      </nav>
    </div>
  </div>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0" aria-hidden="true">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
